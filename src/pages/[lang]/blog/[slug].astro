---
import { useT } from '@/i18n/ui';
import { getCollection, render } from 'astro:content';
import TerminalLayout from '@/layouts/TerminalLayout.astro';
import { isoDate, pageUrl, postSlug } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { lang } = post.data;
const { Content } = await render(post);
const t = useT(lang);
---

<TerminalLayout
  title={`${post.data.title} // kfolio`}
  description={post.data.description}
  lang={lang}
  currentPage="blog"
>
  <div class="blog-article-container">
    <!-- Article Content -->
    <article class="blog-article-wrapper">
      <header class="card blog-header-card">
        <div class="blog-header-topline">
          <a
            href={pageUrl(lang, 'blog')}
            class="blog-inline-back-btn"
          >
            <span aria-hidden="true">&lt;</span>
            <span>{t('blog.back')}</span>
          </a>

          <div class="blog-meta-row">
            <time datetime={post.data.pubDate.toISOString()} class="blog-pubdate">
              {isoDate(post.data.pubDate)}
            </time>
            <span class="meta-dot">·</span>
            <span class="blog-author">{post.data.author}</span>
            <span class="meta-dot">·</span>
            <span class="tag blog-lang-tag">{lang.toUpperCase()}</span>
          </div>
        </div>

        <h1 class="blog-article-title">
          {post.data.title}
        </h1>

        <p class="blog-lead-desc">
          {post.data.description}
        </p>

        <div class="tags-wrap" style="margin-top: 0.85rem;">
          {post.data.tags.map((tag) => (
            <span class="tag" style="font-size: 11px;">#{tag}</span>
          ))}
        </div>
      </header>

      <div class="card blog-markdown-body">
        <Content />
      </div>
    </article>
  </div>
</TerminalLayout>

<style>
  .blog-article-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blog-article-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  .blog-header-card {
    border-left: 4px solid var(--accent-gold);
    padding: 1.4rem 1.85rem;
    width: 100%;
    box-sizing: border-box;
  }

  .blog-header-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border-subtle);
  }

  .blog-inline-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    color: var(--accent-gold);
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .blog-inline-back-btn:hover {
    background: var(--accent-gold);
    color: var(--btn-active-text);
    border-color: var(--accent-gold);
  }

  .blog-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--text-muted);
  }

  .blog-pubdate {
    font-family: var(--font-mono);
    color: var(--accent-amber);
    font-weight: 600;
  }

  .meta-dot {
    color: var(--border-hover);
  }

  .blog-author {
    color: var(--text-main);
  }

  .blog-lang-tag {
    font-size: 9.5px;
    padding: 1px 5px;
  }

  .blog-article-title {
    color: var(--text-white);
    font-size: 1.7rem;
    line-height: 1.3;
    margin: 0 0 0.65rem 0;
    font-weight: 800;
  }

  .blog-lead-desc {
    font-size: 13.5px;
    color: var(--text-main);
    margin: 0.75rem 0 0 0;
    line-height: 1.6;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.75rem;
  }

  .blog-markdown-body {
    padding: 1.8rem 2rem;
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-main);
    width: 100%;
    box-sizing: border-box;
  }

  .blog-markdown-body :global(h2) {
    color: var(--text-white);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 1.75rem 0 0.85rem 0;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.4rem;
  }

  .blog-markdown-body :global(h2:first-child) {
    margin-top: 0;
  }

  .blog-markdown-body :global(h3) {
    color: var(--accent-amber);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 1.4rem 0 0.65rem 0;
  }

  .blog-markdown-body :global(p) {
    margin: 0.85rem 0;
    line-height: 1.75;
  }

  .blog-markdown-body :global(ol),
  .blog-markdown-body :global(ul) {
    margin: 0.85rem 0 0.85rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-markdown-body :global(li) {
    line-height: 1.65;
  }

  .blog-markdown-body :global(code) {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 12px;
    color: var(--accent-gold);
    font-family: var(--font-mono);
  }

  .blog-markdown-body :global(pre) {
    background: var(--bg-base) !important;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.2rem 0;
  }

  .blog-markdown-body :global(pre code) {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    color: var(--text-main);
  }

  .blog-markdown-body :global(blockquote) {
    border-left: 3px solid var(--accent-gold);
    background: var(--bg-subtle);
    padding: 0.75rem 1.25rem;
    border-radius: 0 6px 6px 0;
    margin: 1.2rem 0;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .blog-header-card,
    .blog-markdown-body {
      padding: 1.15rem;
    }

    .blog-article-title {
      font-size: 1.35rem;
    }
  }
</style>
