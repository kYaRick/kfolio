---
import { useT } from '@/i18n/ui';
import type { Lang } from '@/lib/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<div
  class="dog-widget"
  data-pixel-dog
  data-lang={lang}
  data-badge-site={t('dog.badgeSite')}
  data-badge-hn={t('dog.badgeHn')}
  data-hn-details={t('dog.hnDetails')}
  data-empty={t('dog.empty')}
>
  <!-- Compact collapsed launcher (shown when html:not(.fx-dog-on)) -->
  <button
    type="button"
    class="dog-launcher"
    data-dog-open
    title={t('dog.open')}
    aria-label={t('dog.open')}
  >
    <svg viewBox="0 0 16 16" width="20" height="20" shape-rendering="crispEdges" aria-hidden="true">
      <rect x="3" y="4" width="2" height="3" fill="var(--accent-amber)" />
      <rect x="11" y="4" width="2" height="3" fill="var(--accent-amber)" />
      <rect x="5" y="3" width="6" height="5" fill="var(--accent-gold)" />
      <rect x="6" y="5" width="1" height="1" fill="var(--bg-header)" />
      <rect x="9" y="5" width="1" height="1" fill="var(--bg-header)" />
      <rect x="7" y="6" width="2" height="2" fill="var(--text-white)" />
      <rect x="7" y="6" width="2" height="1" fill="var(--bg-header)" />
      <rect x="5" y="9" width="6" height="4" fill="var(--accent-gold)" />
      <rect x="6" y="8" width="4" height="1" fill="var(--accent-blue, #58a6ff)" />
    </svg>
  </button>

  <!-- Active assistant stage (shown when html.fx-dog-on) -->
  <div class="dog-stage" data-dog-stage>
    <div class="dog-bubble" role="status" aria-live="polite">
      <div class="dog-bubble-head">
        <span class="dog-badge" data-dog-badge>{t('dog.badgeSite')}</span>
        <button
          type="button"
          class="dog-hide-btn"
          data-dog-dismiss-bubble
          title={t('dog.hide')}
          aria-label={t('dog.hide')}
        >
          <Icon name="close" size={12} />
        </button>
      </div>

      <p class="dog-text" data-dog-text></p>

      <details class="dog-hn-details" data-dog-details hidden>
        <summary>{t('dog.hnDetails')}</summary>
        <a href="https://news.ycombinator.com" target="_blank" rel="noopener noreferrer" data-dog-link></a>
      </details>

      <div class="dog-actions">
        <button type="button" class="dog-action-btn" data-dog-next>{t('dog.next')}</button>
        <button type="button" class="dog-action-btn" data-dog-history>{t('dog.history')}</button>
      </div>
    </div>

    <div class="dog-sprite-wrap">
      <div class="dog-think-cloud" aria-hidden="true">
        <span class="dog-think-dot d1"></span>
        <span class="dog-think-dot d2"></span>
        <span class="dog-think-dot d3"></span>
      </div>

      <button
        type="button"
        class="dog-power-btn"
        data-dog-hide
        title={t('dog.hide')}
        aria-label={t('dog.hide')}
      >
        <Icon name="close" size={10} />
      </button>

      <button
        type="button"
        class="dog-sprite-btn"
        data-dog-sprite
        data-anim="idle"
        title={t('dog.history')}
        aria-label={t('dog.history')}
      >
      <svg viewBox="0 0 16 16" width="48" height="48" shape-rendering="crispEdges" aria-hidden="true" class="dog-svg">
        <!-- Tail -->
        <g class="dog-tail">
          <rect x="11" y="11" width="1" height="1" fill="var(--accent-gold)" />
          <rect x="12" y="10" width="1" height="1" fill="var(--accent-gold)" />
          <rect x="13" y="9" width="1" height="1" fill="var(--accent-amber)" />
        </g>

        <!-- Body -->
        <rect x="4" y="8" width="7" height="5" fill="var(--accent-gold)" />
        <rect x="6" y="8" width="3" height="4" fill="var(--text-white)" />
        <!-- Collar -->
        <rect x="5" y="7" width="5" height="1" fill="var(--accent-blue, #58a6ff)" />

        <!-- Paws -->
        <g class="dog-paws">
          <rect class="dog-paw-l" x="4" y="13" width="2" height="1" fill="var(--text-white)" />
          <rect class="dog-paw-r" x="9" y="13" width="2" height="1" fill="var(--text-white)" />
        </g>

        <!-- Scratching hind leg (visible during scratch animation) -->
        <g class="dog-scratch-leg">
          <rect x="2" y="10" width="2" height="2" fill="var(--accent-amber)" />
          <rect x="2" y="9" width="1" height="1" fill="var(--text-white)" />
        </g>

        <!-- Head group (tilts during scratch, bobs on walk/speak) -->
        <g class="dog-head">
          <!-- Floppy ears -->
          <g class="dog-ears">
            <rect x="3" y="2" width="1" height="5" fill="var(--accent-amber)" />
            <rect x="2" y="3" width="1" height="4" fill="var(--accent-amber)" />
            <rect x="11" y="2" width="1" height="5" fill="var(--accent-amber)" />
            <rect x="12" y="3" width="1" height="4" fill="var(--accent-amber)" />
          </g>
          <!-- Head base -->
          <rect x="4" y="2" width="7" height="5" fill="var(--accent-gold)" />
          <rect x="5" y="1" width="5" height="1" fill="var(--accent-gold)" />
          <!-- Eyes -->
          <g class="dog-eyes">
            <rect x="5" y="4" width="1" height="1" fill="var(--bg-header)" />
            <rect x="9" y="4" width="1" height="1" fill="var(--bg-header)" />
          </g>
          <!-- Snout & nose -->
          <rect x="6" y="5" width="3" height="2" fill="var(--text-white)" />
          <rect x="7" y="5" width="1" height="1" fill="var(--bg-header)" />
        </g>
      </svg>
    </button>
    </div>
  </div>
</div>

<!-- Assistant Log / History Modal -->
<div class="modal-overlay" id="modal-dog-history" role="dialog" aria-modal="true" aria-labelledby="dog-history-title">
  <div class="modal-dialog dog-history-dialog">
    <div class="modal-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <Icon name="wand" size={16} />
        <span class="modal-title" id="dog-history-title">{t('dog.historyTitle')}</span>
      </div>
      <button type="button" class="modal-close-btn" data-dog-modal-close aria-label="Close modal">
        <Icon name="close" size={16} />
      </button>
    </div>

    <div class="modal-body dog-history-body" data-dog-history-list></div>

    <div class="modal-footer dog-history-footer">
      <button type="button" class="dog-action-btn" data-dog-clear>{t('dog.clear')}</button>
    </div>
  </div>
</div>

<style is:global>
  .dog-widget {
    position: fixed;
    right: 24px;
    bottom: 24px;
    transform: translateY(var(--btt-lift, 0px));
    transition: right 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 155;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    pointer-events: none;
  }

  @media (min-width: 769px) {
    html.has-scrolled .dog-widget {
      right: 86px;
    }
  }

  @media (max-width: 768px) {
    .dog-widget {
      right: 14px;
      bottom: 16px;
      transform: none;
    }
  }

  @media print {
    .dog-widget,
    #modal-dog-history {
      display: none !important;
    }
  }

  .dog-launcher,
  .dog-stage {
    pointer-events: auto;
  }

  .dog-launcher {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--bg-header) 90%, transparent);
    box-shadow: var(--shadow-panel);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.78;
    transition: opacity 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .dog-launcher:hover,
  .dog-launcher:focus-visible {
    opacity: 1;
    border-color: var(--accent-gold);
    transform: translateY(-2px);
  }

  html.fx-dog-on .dog-launcher {
    display: none;
  }

  .dog-stage {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  html.fx-dog-on .dog-stage {
    display: flex;
  }

  .dog-stage.is-bubble-hidden .dog-bubble {
    display: none;
  }

  .dog-sprite-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dog-power-btn {
    position: absolute;
    top: -6px;
    right: -6px;
    z-index: 2;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--bg-header);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
    transition: opacity 0.15s ease, transform 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  @media (hover: hover) {
    .dog-sprite-wrap:hover .dog-power-btn {
      opacity: 0.9;
      pointer-events: auto;
      transform: scale(1);
    }
  }

  .dog-sprite-wrap:focus-within .dog-power-btn,
  .dog-sprite-wrap.show-power .dog-power-btn {
    opacity: 0.95;
    pointer-events: auto;
    transform: scale(1);
  }

  .dog-power-btn:hover {
    opacity: 1;
    color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .dog-think-cloud {
    position: absolute;
    top: -22px;
    right: 6px;
    display: none;
    align-items: flex-end;
    gap: 3px;
    pointer-events: none;
  }

  .dog-sprite-wrap:has([data-anim='think']) .dog-think-cloud {
    display: flex;
  }

  .dog-think-dot {
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--accent-gold);
    border: 1px solid var(--bg-header);
    animation: dog-think-float 0.8s steps(2, end) infinite;
  }

  .dog-think-dot.d1 { width: 4px; height: 4px; animation-delay: 0s; }
  .dog-think-dot.d2 { width: 5px; height: 5px; animation-delay: 0.2s; }
  .dog-think-dot.d3 { width: 7px; height: 7px; animation-delay: 0.4s; }

  .dog-sprite-btn[data-anim='think'] .dog-head {
    animation: dog-head-think 1.1s steps(2, end) infinite;
  }

  @keyframes dog-think-float {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(-3px); opacity: 1; }
  }

  @keyframes dog-head-think {
    0%, 100% { transform: rotate(6deg); }
    50% { transform: rotate(10deg) translateY(-1px); }
  }

  .dog-bubble {
    position: relative;
    width: min(280px, calc(100vw - 32px));
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--bg-header) 96%, transparent);
    box-shadow: var(--shadow-panel);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.45;
    color: var(--text-main);
  }

  .dog-bubble::after {
    content: '';
    position: absolute;
    right: 18px;
    bottom: -6px;
    width: 10px;
    height: 10px;
    background: color-mix(in srgb, var(--bg-header) 96%, transparent);
    border-right: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    transform: rotate(45deg);
  }

  .dog-bubble-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .dog-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--accent-gold);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .dog-hide-btn {
    border: 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    padding: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .dog-hide-btn:hover {
    color: var(--text-main);
    background: var(--tag-bg);
  }

  .dog-text {
    margin: 0 0 8px;
    color: var(--text-main);
    word-break: break-word;
  }

  .dog-hn-details {
    margin-bottom: 8px;
    font-size: 11px;
    color: var(--text-muted);
  }

  .dog-hn-details summary {
    cursor: pointer;
    color: var(--accent-amber);
    font-weight: 600;
    user-select: none;
  }

  .dog-hn-details a {
    display: inline-block;
    margin-top: 4px;
    color: var(--accent-blue, var(--accent-gold));
    text-decoration: underline;
    word-break: break-all;
  }

  .dog-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dog-action-btn {
    padding: 4px 9px;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .dog-action-btn:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
    background: var(--tag-bg);
  }

  .dog-sprite-btn {
    border: 0;
    padding: 2px;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .dog-sprite-btn:hover {
    transform: translateY(-2px);
  }

  .dog-sprite-btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .dog-svg {
    overflow: visible;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }

  .dog-tail {
    transform-origin: 11px 11px;
    animation: dog-wag 0.9s steps(2, end) infinite;
  }

  .dog-eyes {
    transform-origin: 7px 4.5px;
    animation: dog-blink 4.2s steps(1, end) infinite;
  }

  .dog-scratch-leg {
    opacity: 0;
    transform-origin: 3px 11px;
  }

  .dog-head {
    transform-origin: 7px 6px;
  }

  .dog-sprite-btn[data-anim='scratch'] .dog-scratch-leg {
    opacity: 1;
    animation: dog-leg-kick 0.24s steps(2, end) infinite;
  }

  .dog-sprite-btn[data-anim='scratch'] .dog-head {
    animation: dog-head-scratch 0.5s steps(2, end) infinite;
  }

  .dog-sprite-btn[data-anim='walk'] {
    animation: dog-walk-patrol 3.6s ease-in-out infinite;
  }

  .dog-sprite-btn[data-anim='walk'] .dog-paw-l {
    animation: dog-paw-step 0.35s steps(2, end) infinite;
  }

  .dog-sprite-btn[data-anim='walk'] .dog-paw-r {
    animation: dog-paw-step 0.35s steps(2, end) infinite 0.17s;
  }

  .dog-sprite-btn[data-anim='walk'] .dog-svg {
    animation: dog-walk-bob 0.35s steps(2, end) infinite;
  }

  .dog-sprite-btn[data-anim='speak'] .dog-svg {
    animation: dog-speak-hop 0.45s steps(2, end) 2;
  }

  .dog-bubble.is-popping {
    animation: dog-bubble-pop 0.25s ease;
  }

  @keyframes dog-wag {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(14deg); }
  }

  @keyframes dog-blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }

  @keyframes dog-leg-kick {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-1px, -2px) rotate(-18deg); }
  }

  @keyframes dog-head-scratch {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(-12deg) translateY(1px); }
  }

  @keyframes dog-walk-patrol {
    0%, 100% { transform: translateX(0); }
    45% { transform: translateX(-36px); }
    50% { transform: translateX(-36px) scaleX(-1); }
    95% { transform: translateX(0) scaleX(-1); }
  }

  @keyframes dog-paw-step {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-1px); }
  }

  @keyframes dog-walk-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-1px); }
  }

  @keyframes dog-speak-hop {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  @keyframes dog-bubble-pop {
    0% { transform: scale(0.96); }
    60% { transform: scale(1.02); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dog-tail,
    .dog-eyes,
    .dog-scratch-leg,
    .dog-head,
    .dog-sprite-btn,
    .dog-paw-l,
    .dog-paw-r,
    .dog-svg,
    .dog-bubble.is-popping {
      animation: none !important;
    }
  }

  html.fx-reduced .dog-tail,
  html.fx-reduced .dog-eyes,
  html.fx-reduced .dog-scratch-leg,
  html.fx-reduced .dog-head,
  html.fx-reduced .dog-sprite-btn,
  html.fx-reduced .dog-paw-l,
  html.fx-reduced .dog-paw-r,
  html.fx-reduced .dog-svg,
  html.fx-reduced .dog-bubble.is-popping {
    animation: none !important;
  }

  .dog-history-dialog {
    max-width: 460px;
  }

  .dog-history-body {
    max-height: 55vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dog-history-item {
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-base) 55%, transparent);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .dog-history-item .dog-badge {
    display: inline-block;
    margin-bottom: 4px;
  }

  .dog-history-item p {
    margin: 0;
    color: var(--text-main);
  }

  .dog-history-item details {
    margin-top: 6px;
    font-size: 11px;
  }

  .dog-history-item summary {
    cursor: pointer;
    color: var(--accent-amber);
  }

  .dog-history-item a {
    display: inline-block;
    margin-top: 4px;
    color: var(--accent-blue, var(--accent-gold));
    word-break: break-all;
  }

  .dog-history-footer {
    display: flex;
    justify-content: flex-end;
    padding: 10px 16px;
    border-top: 1px solid var(--border-subtle);
  }
</style>

<script>
  import '@/scripts/pixel-dog';
</script>
