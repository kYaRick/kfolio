---
import { useT } from '@/i18n/ui';
import type { Lang } from '@/lib/site';
import Icon from './Icon.astro';

interface Props {
  aspirations: {
    intro: string;
    focus: Array<{ area: string; desc: string }>;
    militaryProjects?: string;
    personal?: string;
  };
  lang: Lang;
}

const { aspirations, lang } = Astro.props;
const t = useT(lang);
---

<section class="card aspirations-card" aria-label="Career Aspirations and Special Projects">
  <div class="card-title">
    <div style="display: flex; align-items: center; gap: 6px;">
      <Icon name="target" size={15} />
      <span>{t('aspirations.title')}</span>
    </div>
    <span style="font-size: 10px; color: var(--accent-amber);">EVOLVING FOCUS</span>
  </div>

  <p style="font-size: 12px; color: var(--text-main);">{aspirations.intro}</p>

  <div class="aspirations-list">
    {aspirations.focus.map((item) => (
      <div class="aspiration-item">
        <span class="aspiration-area">{item.area}:</span>
        <span style="color: var(--text-muted); margin-left: 4px;">{item.desc}</span>
      </div>
    ))}
  </div>

  {aspirations.militaryProjects && (
    <div style="background: var(--bg-subtle); border-left: 2px solid var(--accent-amber); padding: 0.5rem 0.8rem; border-radius: 0 4px 4px 0; margin-top: 0.3rem;">
      <span style="color: var(--accent-gold); font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 5px; margin-bottom: 2px;">
        <Icon name="shield" size={13} />
        <span>{t('aspirations.defense')}</span>
      </span>
      <p style="font-size: 11.5px; color: var(--text-main); margin: 0;">{aspirations.militaryProjects}</p>
    </div>
  )}

  {aspirations.personal && (
    <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 0.2rem;">
      <strong style="color: var(--accent-dim);">{t('aspirations.personal')}</strong> {aspirations.personal}
    </div>
  )}
</section>
