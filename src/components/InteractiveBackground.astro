---
// Interactive canvas background engine with 4 distinct theme scenes
---

<canvas id="interactive-bg-canvas" class="interactive-bg-canvas" transition:persist aria-hidden="true"></canvas>

<style>
  .interactive-bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;
    transition: opacity 0.4s ease;
  }

  @media print {
    .interactive-bg-canvas {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    if (window.__interactiveBgInitialized) return;
    window.__interactiveBgInitialized = true;

    const canvas = document.getElementById('interactive-bg-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);
    let animId = null;
    let isEnabled = localStorage.getItem('kfolio_bg_fx') !== 'false';
    let interact = localStorage.getItem('kfolio_bg_interact') !== 'false';
    const isReduced = () =>
      document.documentElement.classList.contains('fx-reduced') ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const mouse = { x: -1000, y: -1000, active: false };

    // Resize handler
    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      initParticles();
      requestRedraw();
    });

    // Mouse tracking for subtle natural breeze deflection
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;
      if (interact) requestRedraw();
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
      mouse.active = false;
    });

    // Particles list
    let particles = [];

    function initParticles() {
      particles = [];
      const count = Math.min(Math.floor((width * height) / 14000), 85);
      for (let i = 0; i < count; i++) {
        const isCrystal = Math.random() < 0.28;
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.6,
          vy: Math.random() * 0.9 + 0.6,
          swayAngle: Math.random() * Math.PI * 2,
          swaySpeed: Math.random() * 0.02 + 0.01,
          swayRadius: Math.random() * 0.8 + 0.4,
          radius: isCrystal ? Math.random() * 2 + 3 : Math.random() * 1.8 + 0.8,
          alpha: Math.random() * 0.55 + 0.35,
          isCrystal: isCrystal,
          rotation: Math.random() * Math.PI * 2,
          rotSpeed: (Math.random() - 0.5) * 0.02,
          // ambient (non-snow) scenes: slow drift in any direction, twinkling size
          dx: (Math.random() - 0.5) * 0.16,
          dy: (Math.random() - 0.5) * 0.16,
          size: Math.random() * 2.4 + 1.3,
          phase: Math.random() * Math.PI * 2,
          phaseSpeed: Math.random() * 0.025 + 0.008
        });
      }
    }

    initParticles();

    // Helper: draw crisp 6-point ice crystal
    function drawSnowCrystal(p) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.strokeStyle = `rgba(255, 255, 255, ${p.alpha})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        ctx.moveTo(0, 0);
        ctx.lineTo(0, p.radius);
        if (p.radius > 3.2) {
          ctx.moveTo(0, p.radius * 0.55);
          ctx.lineTo(p.radius * 0.25, p.radius * 0.7);
          ctx.moveTo(0, p.radius * 0.55);
          ctx.lineTo(-p.radius * 0.25, p.radius * 0.7);
        }
        ctx.rotate(Math.PI / 3);
      }
      ctx.stroke();
      ctx.restore();
    }

    const BOKEH = 4.5; // px of blur for out-of-focus dots (ambient themes only, not snow)

    // Ambient scene for non-winter themes: particles float in place (no falling),
    // twinkle by changing size, grow and link to the cursor when it comes close.
    function drawAmbient(color, linkColor, radius) {
      const still = isReduced();
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        if (!still) {
          p.x += p.dx;
          p.y += p.dy;
          p.phase += p.phaseSpeed;
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;
          if (p.y < -10) p.y = height + 10;
          if (p.y > height + 10) p.y = -10;
        }

        let grow = 1;
        let target = 0; // 0 = out of focus (blurred), 1 = in focus near the cursor
        if (interact && mouse.active) {
          const dx = mouse.x - p.x;
          const dy = mouse.y - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < radius) {
            const k = 1 - dist / radius;
            target = Math.min(1, k * 1.6);
            grow = 1 + k * 0.9;
            ctx.strokeStyle = linkColor(0.35 * k);
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }
        // ease focus in and out, so dots "rack focus" instead of snapping
        p.focus = still ? target : (p.focus || 0) + (target - (p.focus || 0)) * 0.12;

        const twinkle = still ? 1 : 0.7 + 0.45 * Math.sin(p.phase);
        const r = p.size * twinkle * grow;
        const soft = BOKEH * (1 - p.focus); // blur radius in px
        const a = p.alpha * (0.55 + 0.35 * twinkle) * (0.7 + 0.3 * p.focus);
        if (soft < 0.4) {
          ctx.fillStyle = color(a);
          ctx.beginPath();
          ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
          ctx.fill();
        } else {
          const outer = r + soft;
          const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, outer);
          g.addColorStop(0, color(a));
          g.addColorStop(Math.max(0.05, (r - soft * 0.5) / outer), color(a * 0.85));
          g.addColorStop(1, color(0));
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(p.x, p.y, outer, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function draw() {
      if (!isEnabled) {
        ctx.clearRect(0, 0, width, height);
        return;
      }

      ctx.clearRect(0, 0, width, height);
      const theme = document.documentElement.getAttribute('data-theme') || 'hermes-dark';

      if (theme === 'seasonal-winter') {
        // Natural Gentle Falling Snow Scene
        ctx.save();
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];

          // Natural swaying and falling
          if (!isReduced()) {
            p.swayAngle += p.swaySpeed;
            p.x += Math.sin(p.swayAngle) * p.swayRadius;
            p.y += p.vy;
            p.rotation += p.rotSpeed;
          }

          // Subtle wind deflection near mouse cursor (no weird trails)
          if (interact && mouse.active) {
            const dx = p.x - mouse.x;
            const dy = p.y - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 110 && dist > 0) {
              const force = (1 - dist / 110) * 1.8;
              p.x += (dx / dist) * force;
              p.y += (dy / dist) * (force * 0.5);
            }
          }

          // Screen loop
          if (p.y > height + 10) {
            p.y = -10;
            p.x = Math.random() * width;
          }
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;

          // Render: either crystal or soft snow dot
          if (p.isCrystal) {
            drawSnowCrystal(p);
          } else {
            ctx.fillStyle = `rgba(240, 249, 255, ${p.alpha})`;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.restore();
      } else if (theme === 'hermes-light') {
        drawAmbient((a) => `rgba(71, 85, 105, ${a})`, (a) => `rgba(3, 105, 161, ${a})`, 120);
      } else if (theme === 'fluent-dark') {
        drawAmbient((a) => `rgba(96, 205, 255, ${a})`, (a) => `rgba(96, 205, 255, ${a})`, 130);
      } else {
        drawAmbient((a) => `rgba(255, 215, 0, ${a})`, (a) => `rgba(255, 215, 0, ${a})`, 120);
      }

      // Reduced motion: the scene is static, so draw one frame and stop.
      // requestRedraw() paints again on cursor move, resize or theme change.
      animId = isReduced() ? null : requestAnimationFrame(draw);
    }

    function startLoop() {
      if (animId) cancelAnimationFrame(animId);
      animId = requestAnimationFrame(draw);
    }

    function requestRedraw() {
      if (!animId && isEnabled) animId = requestAnimationFrame(draw);
    }

    new MutationObserver(requestRedraw).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'class'],
    });

    startLoop();

    // Global toggle controller
    window.__setBgFx = function (enabled) {
      isEnabled = !!enabled;
      localStorage.setItem('kfolio_bg_fx', isEnabled ? 'true' : 'false');
      canvas.style.display = isEnabled ? 'block' : 'none';
      if (isEnabled) {
        startLoop();
      } else {
        ctx.clearRect(0, 0, width, height);
      }
    };

    window.__setBgInteract = function (enabled) {
      interact = !!enabled;
      localStorage.setItem('kfolio_bg_interact', interact ? 'true' : 'false');
    };

    if (!isEnabled) {
      canvas.style.display = 'none';
    }
  })();
</script>
