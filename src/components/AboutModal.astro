---
import { useT } from '@/i18n/ui';
import { url, type Lang } from '@/lib/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<div class="modal-overlay" id="modal-about" role="dialog" aria-modal="true" aria-labelledby="about-modal-title">
  <div class="modal-dialog">
    <div class="modal-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <Icon name="info" size={15} />
        <span class="modal-title" id="about-modal-title">{t('about.title')}</span>
      </div>
      <button type="button" class="modal-close-btn" id="close-about-btn" aria-label="Close modal">
        <Icon name="close" size={15} />
      </button>
    </div>

    <div class="modal-body">
      <div style="display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.85rem;">
        <div style="background: var(--bg-subtle); border: 1.5px solid var(--border-color); border-radius: 8px; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 6px;">
          <img src={url('favicon.ico')} alt="kfolio favicon" style="width: 36px; height: 36px; object-fit: contain;" />
        </div>
        <div>
          <h2 style="font-size: 1.2rem; color: var(--text-white); margin: 0;">{t('about.heading')}</h2>
          <span style="font-size: 11px; color: var(--accent-amber);">Version 2.0.0 (Release)</span>
        </div>
      </div>

      <p style="font-size: 12px; color: var(--text-main); line-height: 1.6;">
        {t('about.body')}
      </p>

      <div class="key-value-list" style="background: var(--bg-subtle); padding: 0.85rem; border-radius: 6px; border: 1px solid var(--border-subtle);">
        <div class="kv-row">
          <span class="kv-key">Engine:</span>
          <span class="kv-value">Astro 5.x (Content Layer)</span>
        </div>
        <div class="kv-row">
          <span class="kv-key">Typing:</span>
          <span class="kv-value">TypeScript (Strict)</span>
        </div>
        <div class="kv-row">
          <span class="kv-key">Styling:</span>
          <span class="kv-value">Vanilla CSS · Custom Properties · Print Stylesheet</span>
        </div>
        <div class="kv-row">
          <span class="kv-key">Hosting:</span>
          <span class="kv-value">GitHub Pages via GitHub Actions</span>
        </div>
        <div class="kv-row">
          <span class="kv-key">License:</span>
          <span class="kv-value">MIT Open Source</span>
        </div>
      </div>
    </div>
  </div>
</div>
