---
import { useT } from '@/i18n/ui';
import { pageUrl, type Lang, type Page } from '@/lib/site';
import Icon from './Icon.astro';

interface Props {
  currentLang?: Lang;
  currentPage?: Page;
}

const {
  currentLang = "en",
  currentPage = "cv"
} = Astro.props;

const ukPath = pageUrl('uk', currentPage);
const enPath = pageUrl('en', currentPage);
const cvPath = pageUrl(currentLang);
const blogPath = pageUrl(currentLang, 'blog');
const t = useT(currentLang);
---

<header class="site-header">
  <!-- Left: page switcher, terminal tabs -->
  <nav class="header-pages" aria-label="Main Navigation">
    <a
      href={cvPath}
      class={`page-tab ${currentPage === 'cv' ? 'active' : ''}`}
      aria-current={currentPage === 'cv' ? 'page' : undefined}
      title={t('nav.cv')}
    >
      <Icon name="file-text" size={13} />
      <span>~/cv</span>
    </a>
    <a
      href={blogPath}
      class={`page-tab ${currentPage === 'blog' ? 'active' : ''}`}
      aria-current={currentPage === 'blog' ? 'page' : undefined}
      title={t('nav.blog')}
    >
      <Icon name="pen-tool" size={13} />
      <span>~/blog</span>
    </a>
  </nav>
  <!-- Center: brand -->
  <a href={cvPath} class="header-brand">
    <span class="status-pulse-dot"></span>
    <span class="header-agent-name">kfolio</span>
    <span class="header-dot">·</span>
    <span class="header-session">kyarick@hypervisor</span>
  </a>

  <!-- Right: tools (settings, page actions, language) -->
  <div class="header-tools">
    <button
      type="button"
      class="nav-item has-tooltip"
      id="btn-open-settings"
      aria-label={t('nav.settings')}
      title={t('nav.settings')}
      data-tooltip={t('nav.settings')}
    >
      <Icon name="settings" size={15} />
    </button>

    <div class="header-divider" aria-hidden="true"></div>

    <button
      type="button"
      id="btn-toggle-reading-mode"
      class="nav-item reading-mode-btn has-tooltip"
      title={t('nav.readingModeHint')}
      aria-label={t('nav.readingMode')}
      data-tooltip={t('experience.expandAll')}
    >
      <span class="icon-eye-wrap" style="display: inline-flex; align-items: center;">
        <Icon name="eye" size={15} />
      </span>
    </button>
    <button
      type="button"
      id="btn-export-pdf"
      class="nav-item pdf-btn has-tooltip"
      title={t('nav.print')}
      aria-label={t('nav.print')}
      data-tooltip={t('nav.printShort')}
    >
      <Icon name="printer" size={15} />
    </button>

    <div class="header-divider" aria-hidden="true"></div>

    <div class="header-lang-switch">
      <a href={ukPath} class={`tool-pill ${currentLang === 'uk' ? 'active' : ''}`} data-lang="uk" title="Українська">UA</a>
      <a href={enPath} class={`tool-pill ${currentLang === 'en' ? 'active' : ''}`} data-lang="en" title="English">EN</a>
    </div>
  </div>

</header>
