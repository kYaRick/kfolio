---
import { useT } from '@/i18n/ui';
import { url, type Lang, type Page } from '@/lib/site';
import '@/styles/theme.css';
import '@/styles/terminal.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '@/components/SiteHeader.astro';
import AboutModal from '@/components/AboutModal.astro';
import SettingsModal from '@/components/SettingsModal.astro';
import InteractiveBackground from '@/components/InteractiveBackground.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  currentPage?: Page;
}

const {
  title = "Yaroslav Kyliushyk // Software Tools & Application Engineer",
  description = "Personal CV and engineering dispatches for Yaroslav Kyliushyk.",
  lang = "en",
  currentPage = "cv"
} = Astro.props;
const t = useT(lang);
---

<!doctype html>
<html lang={lang} data-theme="hermes-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={url('favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />

    <!-- Google Font: JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <!-- Anti-flicker Theme Init Script -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('kfolio_theme') || 'hermes-dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>
  </head>
  <body class={currentPage === 'blog' ? 'page-blog' : 'page-cv'} data-msg-print-blocked={t('print.blogBlocked')}>
    <!-- Top Progress Loading Bar for startup & smooth navigation (persisted across swaps) -->
    <div id="page-loading-bar" class="page-loading-bar" transition:persist aria-hidden="true"></div>

    <!-- Reading Progress Bar for articles and long pages -->
    <div id="reading-progress-bar" class="reading-progress-bar" transition:persist aria-hidden="true"></div>

    <!-- Top HUD Navigation Loading Indicator (persisted across swaps) -->
    <div
      id="nav-loading-pill"
      class="nav-loading-pill"
      transition:persist
      aria-hidden="true"
      data-loading-uk={useT('uk')('nav.loading')}
      data-loading-en={useT('en')('nav.loading')}
    >
      <span class="nav-loading-spinner" aria-hidden="true"></span>
      <span class="nav-loading-text">{t('nav.loading')}</span>
    </div>

    <!-- Immediate startup loader trigger for fast feedback -->
    <script is:inline>
      (function() {
        const bar = document.getElementById('page-loading-bar');
        if (bar && !window.__siteBootstrapped) {
          bar.style.opacity = '1';
          bar.style.width = '45%';
          window.addEventListener('DOMContentLoaded', () => {
            if (bar.style.opacity === '1') bar.style.width = '85%';
          }, { once: true });
          window.addEventListener('load', () => {
            bar.style.width = '100%';
            setTimeout(() => { bar.style.opacity = '0'; }, 200);
            setTimeout(() => {
              if (bar.style.opacity === '0') bar.style.width = '0%';
              window.__siteBootstrapped = true;
            }, 500);
          }, { once: true });
        }
      })();
    </script>

    <!-- Theme-specific Interactive Background Canvas -->
    <InteractiveBackground />

    <div class="site-wrapper">
      <SiteHeader currentLang={lang} currentPage={currentPage} />

      <main class="site-main" transition:animate="fade">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-col-left" aria-hidden="true"></div>

        <span class="footer-love">✨ Made with love to 💛Ukraine💙</span>

        <div class="footer-actions">
          <a
            href="https://github.com/kYaRick/kfolio"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-icon-btn has-tooltip"
            title={t('footer.repo')}
            data-tooltip={t('footer.repo')}
            aria-label="GitHub Repository"
          >
            <Icon name="github" size={15} />
          </a>
          <button
            type="button"
            class="footer-icon-btn has-tooltip"
            id="btn-open-about"
            title={t('footer.about')}
            data-tooltip={t('footer.about')}
            aria-label="About"
          >
            <Icon name="info" size={15} />
          </button>
        </div>
      </footer>
    </div>

    <!-- Floating Back to Top Button with Live Reading Progress -->
    <button
      type="button"
      id="btn-back-to-top"
      class="back-to-top-btn"
      title={t('footer.toTop')}
      aria-label={t('footer.toTop')}
    >
      <Icon name="chevron-up" size={14} />
      <span class="btt-percent" id="btt-percent-label" aria-hidden="true">0%</span>
    </button>

    <!-- Modals -->
    <AboutModal lang={lang} />
    <SettingsModal lang={lang} />

    <!-- Global Client Script: Delegation & Navigation Hooks -->
    <script is:inline>
      // Loading Bar & Navigation Feedback Control
      function triggerLoadStart() {
        document.documentElement.classList.add('is-navigating');
        const bar = document.getElementById('page-loading-bar');
        if (bar) {
          clearTimeout(window.__loadBarTimer);
          bar.style.transition = 'width 0.25s cubic-bezier(0.1, 0.7, 0.1, 1), opacity 0.15s ease';
          bar.style.opacity = '1';
          bar.style.width = '40%';
          window.__loadBarTimer = setTimeout(() => {
            if (document.documentElement.classList.contains('is-navigating') && bar.style.opacity === '1') {
              bar.style.width = '78%';
            }
          }, 80);
        }
      }

      function triggerLoadFinish() {
        const bar = document.getElementById('page-loading-bar');
        if (bar) {
          clearTimeout(window.__loadBarTimer);
          bar.style.width = '100%';
          window.__loadBarTimer = setTimeout(() => {
            bar.style.opacity = '0';
            document.documentElement.classList.remove('is-navigating');
            setTimeout(() => {
              if (bar.style.opacity === '0') bar.style.width = '0%';
            }, 250);
          }, 150);
        } else {
          document.documentElement.classList.remove('is-navigating');
        }
      }

      // Theme Management
      function setTheme(theme) {
        if (!theme) return;
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('kfolio_theme', theme);
        syncThemeButtons(theme);
      }

      function syncThemeButtons(theme) {
        const activeTheme = theme || localStorage.getItem('kfolio_theme') || 'hermes-dark';
        document.querySelectorAll('.theme-quick-btn, .settings-theme-pill').forEach(btn => {
          if (btn.getAttribute('data-theme') === activeTheme) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }

      function syncReadingModeUI(isFull) {
        const btn = document.getElementById('btn-toggle-reading-mode');
        if (btn) {
          btn.classList.toggle('active', isFull);
        }
        if (isFull) {
          document.querySelectorAll('.job-collapsible').forEach(d => {
            if (d && 'open' in d) d.open = true;
          });
          const extraToolsets = document.getElementById('toolsets-extra-wrap');
          if (extraToolsets) extraToolsets.classList.add('open');
          const joke = document.querySelector('.joke-spoiler');
          if (joke && 'open' in joke) joke.open = true;
          const expBtnText = document.querySelector('#btn-toggle-all-exp .toggle-text');
          if (expBtnText) expBtnText.textContent = expBtnText.parentElement?.dataset.labelCollapse || expBtnText.textContent;
        } else {
          document.querySelectorAll('.job-collapsible').forEach((d, idx) => {
            if (d && 'open' in d) d.open = idx === 0;
          });
          const extraToolsets = document.getElementById('toolsets-extra-wrap');
          if (extraToolsets) extraToolsets.classList.remove('open');
          const joke = document.querySelector('.joke-spoiler');
          if (joke && 'open' in joke) joke.open = false;
        }
      }

      // Synchronize state on page swap/load
      function syncSiteState() {
        const currentTheme = localStorage.getItem('kfolio_theme') || 'hermes-dark';
        syncThemeButtons(currentTheme);

        // Sync Background switch
        const toggleBgInput = document.getElementById('toggle-interactive-bg');
        if (toggleBgInput) {
          toggleBgInput.checked = localStorage.getItem('kfolio_bg_fx') !== 'false';
        }

        // Sync Reading Mode
        const savedReadingMode = localStorage.getItem('kfolio_reading_mode') === 'full';
        document.documentElement.classList.toggle('mode-full-reading', savedReadingMode);
        syncReadingModeUI(savedReadingMode);
      }

      // Register global event delegation ONCE
      if (!window.__siteInteractionsInitialized) {
        window.__siteInteractionsInitialized = true;

        document.addEventListener('click', (e) => {
          // Back to Top button
          if (e.target.closest('#btn-back-to-top')) {
            e.preventDefault();
            window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
            document.documentElement.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
            document.body.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
            return;
          }

          // Immediate Navigation Progress on link clicks
          const link = e.target.closest('a');
          if (link && link.href && link.href.startsWith(window.location.origin) && !link.target && !link.hasAttribute('download')) {
            triggerLoadStart();
          }

          // Full Reading Mode Toggle
          if (e.target.closest('#btn-toggle-reading-mode')) {
            const isFull = document.documentElement.classList.toggle('mode-full-reading');
            localStorage.setItem('kfolio_reading_mode', isFull ? 'full' : 'compact');
            syncReadingModeUI(isFull);
            return;
          }

          // Theme button
          const themeBtn = e.target.closest('.theme-quick-btn, .settings-theme-pill');
          if (themeBtn) {
            const theme = themeBtn.getAttribute('data-theme');
            if (theme) setTheme(theme);
            return;
          }

          // Language button
          const langLink = e.target.closest('a[data-lang]');
          if (langLink) {
            const l = langLink.getAttribute('data-lang');
            if (l) localStorage.setItem('kfolio_lang', l);
            return;
          }

          // Settings Tab
          const tabBtn = e.target.closest('.settings-tab-btn');
          if (tabBtn) {
            const targetId = tabBtn.getAttribute('data-target');
            document.querySelectorAll('.settings-tab-btn').forEach(b => {
              b.classList.remove('active');
              b.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('.settings-tab-pane').forEach(p => p.classList.remove('active'));

            tabBtn.classList.add('active');
            tabBtn.setAttribute('aria-selected', 'true');
            const targetPane = document.getElementById(targetId);
            if (targetPane) targetPane.classList.add('active');
            return;
          }

          // Open/Close Modals
          if (e.target.closest('#btn-open-about')) {
            const m = document.getElementById('modal-about');
            if (m) m.classList.add('open');
            return;
          }
          if (e.target.closest('#close-about-btn') || e.target.id === 'modal-about') {
            const m = document.getElementById('modal-about');
            if (m) m.classList.remove('open');
            return;
          }

          if (e.target.closest('#btn-open-settings')) {
            const m = document.getElementById('modal-settings');
            if (m) m.classList.add('open');
            return;
          }
          if (e.target.closest('#close-settings-btn') || e.target.id === 'modal-settings') {
            const m = document.getElementById('modal-settings');
            if (m) m.classList.remove('open');
            return;
          }

          // PDF Print (Quick Header Action or Settings Modal)
          if (e.target.closest('#btn-export-pdf, #btn-settings-export-pdf')) {
            const isBlog = document.body.classList.contains('page-blog');
            if (isBlog) {
              alert(document.body.dataset.msgPrintBlocked);
              return;
            }

            const fromSettings = e.target.closest('#btn-settings-export-pdf');
            if (fromSettings) {
              const exp = document.getElementById('chk-print-exp');
              const stack = document.getElementById('chk-print-stack');
              const edu = document.getElementById('chk-print-edu');
              const asp = document.getElementById('chk-print-asp');
              const bio = document.getElementById('chk-print-bio');

              document.body.classList.toggle('no-print-exp', exp ? !exp.checked : false);
              document.body.classList.toggle('no-print-stack', stack ? !stack.checked : false);
              document.body.classList.toggle('no-print-edu', edu ? !edu.checked : false);
              document.body.classList.toggle('no-print-asp', asp ? !asp.checked : false);
              document.body.classList.toggle('no-print-bio', bio ? !bio.checked : false);

              const mSettings = document.getElementById('modal-settings');
              if (mSettings) mSettings.classList.remove('open');
            }

            // Force expand all collapsibles before print freeze
            document.querySelectorAll('.job-collapsible').forEach(d => {
              if (d && 'open' in d) d.open = true;
            });
            const extraToolsets = document.getElementById('toolsets-extra-wrap');
            if (extraToolsets) extraToolsets.classList.add('open');
            const joke = document.querySelector('.joke-spoiler');
            if (joke && 'open' in joke) joke.open = true;

            setTimeout(() => window.print(), 120);
            return;
          }
        });

        // Background Toggle input
        document.addEventListener('change', (e) => {
          if (e.target.id === 'toggle-interactive-bg') {
            if (typeof window.__setBgFx === 'function') {
              window.__setBgFx(e.target.checked);
            }
          }
        });

        // Escape Key Modal Close
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            const mAbout = document.getElementById('modal-about');
            const mSettings = document.getElementById('modal-settings');
            if (mAbout) mAbout.classList.remove('open');
            if (mSettings) mSettings.classList.remove('open');
          }
        });

        let printDetailsState = [];
        let printExtraToolsetsState = false;
        let printJokeState = false;

        window.addEventListener('beforeprint', () => {
          // Expand all vacancy accordions for printing
          printDetailsState = [];
          document.querySelectorAll('.job-collapsible').forEach(d => {
            if (d && 'open' in d) {
              printDetailsState.push(d.open);
              d.open = true;
            }
          });

          // Expand extra toolsets
          const extraToolsets = document.getElementById('toolsets-extra-wrap');
          if (extraToolsets) {
            printExtraToolsetsState = extraToolsets.classList.contains('open');
            extraToolsets.classList.add('open');
          }

          // Open programmer joke punchline
          const joke = document.querySelector('.joke-spoiler');
          if (joke && 'open' in joke) {
            printJokeState = joke.open;
            joke.open = true;
          }
        });

        window.addEventListener('afterprint', () => {
          document.body.classList.remove(
            'no-print-exp',
            'no-print-stack',
            'no-print-edu',
            'no-print-asp',
            'no-print-bio'
          );

          // Restore state unless user is in Full Reading Mode
          const isFullReading = document.documentElement.classList.contains('mode-full-reading');
          if (!isFullReading) {
            document.querySelectorAll('.job-collapsible').forEach((d, idx) => {
              if (d && 'open' in d && printDetailsState[idx] !== undefined) {
                d.open = printDetailsState[idx];
              }
            });

            const extraToolsets = document.getElementById('toolsets-extra-wrap');
            if (extraToolsets && !printExtraToolsetsState) {
              extraToolsets.classList.remove('open');
            }

            const joke = document.querySelector('.joke-spoiler');
            if (joke && 'open' in joke && !printJokeState) {
              joke.open = false;
            }
          }
        });

        // Live Scroll & Reading Progress Metrics
        function updateScrollMetrics() {
          const scrollY = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
          const scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight || 0;
          const clientHeight = window.innerHeight || document.documentElement.clientHeight || 0;
          const scrollable = scrollHeight - clientHeight;
          const percent = scrollable > 15 ? Math.min(100, Math.max(0, Math.round((scrollY / scrollable) * 100))) : 0;

          // Reading progress bar at the top
          const rBar = document.getElementById('reading-progress-bar');
          if (rBar) {
            rBar.style.width = percent + '%';
            rBar.style.opacity = scrollY > 50 ? '1' : '0';
          }

          // Back to top floating button
          const btn = document.getElementById('btn-back-to-top');
          if (btn) {
            btn.classList.toggle('visible', scrollY > 180);
            const lbl = document.getElementById('btt-percent-label');
            if (lbl) lbl.textContent = percent + '%';

            // Dynamic Footer Avoidance: Elevate button smoothly above footer when in view
            const footer = document.querySelector('.site-footer');
            if (footer) {
              const footerRect = footer.getBoundingClientRect();
              const overlap = window.innerHeight - footerRect.top;
              const baseBottom = window.innerWidth <= 600 ? 16 : 24;
              const lift = Math.max(0, overlap - baseBottom + 12);
              btn.style.setProperty('--btt-lift', `-${lift}px`);
            }
          }
        }
        window.__updateScrollMetrics = updateScrollMetrics;

        window.addEventListener('scroll', updateScrollMetrics, { passive: true });
        window.addEventListener('resize', updateScrollMetrics, { passive: true });
      }

      // Astro View Transitions Hooks
      document.addEventListener('astro:before-preparation', () => {
        triggerLoadStart();
      });

      document.addEventListener('astro:after-swap', () => {
        const bar = document.getElementById('page-loading-bar');
        if (bar) bar.style.width = '90%';
        const savedTheme = localStorage.getItem('kfolio_theme') || 'hermes-dark';
        document.documentElement.setAttribute('data-theme', savedTheme);

        // Synchronize HUD loading text with current language
        const pill = document.getElementById('nav-loading-pill');
        if (pill) {
          const l = document.documentElement.lang || 'uk';
          const txt = pill.querySelector('.nav-loading-text');
          if (txt) {
            txt.textContent = l === 'uk' ? pill.getAttribute('data-loading-uk') : pill.getAttribute('data-loading-en');
          }
        }
      });

      document.addEventListener('astro:page-load', () => {
        triggerLoadFinish();
        syncSiteState();
        if (typeof window.__updateScrollMetrics === 'function') {
          window.__updateScrollMetrics();
        }
      });

      syncSiteState();
      if (typeof window.__updateScrollMetrics === 'function') {
        window.__updateScrollMetrics();
      }
    </script>
  </body>
</html>
