# Normalize line endings for text files, leave binaries untouched
* text=auto eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Lockfile: keep diffs out of reviews
pnpm-lock.yaml -diff linguist-generated
